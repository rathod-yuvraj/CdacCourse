package com.yuvraj.search;

public class BinarySearch {
	private int[] arr= {12,32,54,65,76,35 };
	private static int low=0;
	public  int high=arr.length;
	
	private static int mid =(low+high)/2;
	
	public static int binarySearch(int[] arr,int x) {
		if(arr[mid]==x) {
			return mid;
		}
		if(x<arr[mid]) {
			high=mid-1;
		}
		else {
			low=mid+1;
		}
	}
	
	

}
